# Скопировать в .env и заполнить. Загрузка: set -a; source .env; set +a

# --- Партнёрский API -------------------------------------------------------
BILETDV_API_URL=http://fares.biletdv.ru/SASSirenaFares.asmx/getFaresByFOP_Ex3
BILETDV_PARTNER_ID=KirillTest
# Категории пассажира: каждая — отдельный запрос на маршрут и дату.
BILETDV_CATEGORIES=mla,aaa
# Метка для глубокой ссылки (поле PersonID в отчёте партнёра). Пусто — не добавляем.
BILETDV_PERSON_ID=

# 1 = читать фикстуру, 0 = реальные запросы. На VPS ставить 0.
SUBSIDY_DRY_RUN=1

# --- Что мониторим ---------------------------------------------------------
SUBSIDY_DATE_FROM=2026-10-01
SUBSIDY_DATE_TO=2026-10-30
SUBSIDY_FARE_CODES=PZZSOC,PSOCDO,UBDOWZZ,RBDOWD

# --- Пороги алертов --------------------------------------------------------
SUBSIDY_LOW_SEATS=3
SUBSIDY_SEAT_DROP=5
SUBSIDY_PRICE_DELTA=0
SUBSIDY_ALERT_COOLDOWN=120

# --- Доставка алертов ------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=harhanovk@gmail.com

# --- Пути ------------------------------------------------------------------
SUBSIDY_DATA_DIR=./data

# --- API подписки (subscribe_api.py) ----------------------------------------
# Включайте только там, где сам subscribe_api.py реально запущен и nginx
# проксирует на него /api/subscribe (см. README → «Деплой на VPS»). На
# GitHub Pages оставляйте 0 — бэкенда там нет и кнопка честно скажет,
# что подписка не подключена.
SUBSIDY_SUBSCRIBE_ENABLED=0
SUBSIDY_SUBSCRIBE_HOST=127.0.0.1
SUBSIDY_SUBSCRIBE_PORT=8787
