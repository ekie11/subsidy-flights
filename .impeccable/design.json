    {
      "name": "Карточка рейса",
      "kind": "card",
      "refersTo": "flight-card",
      "description": "Время и путь слева, число мест цветом статуса и действие справа.",
      "html": "<div class=\"ds-flight\"><div class=\"ds-leg\"><div><b>23:55</b><span>KHV</span></div><div class=\"ds-path\"><span>8 ч 20 мин</span><i></i><span>прямой</span></div><div><b>01:15</b><span>SVO</span></div><div class=\"ds-car\"><b>Аэрофлот</b>SU 1711</div></div><div class=\"ds-count\"><b>7</b><span>мест по 10 800 ₽</span><em>Утром было 12</em></div><button class=\"ds-buy\">Купить у партнёра</button></div>",
      "css": ".ds-flight{font-family:Onest,ui-sans-serif,system-ui,sans-serif;display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:24px;align-items:center;background:#fff;border:1px solid #e2e6ef;border-radius:14px;padding:18px 22px;color:#141a29;transition:border-color .18s,box-shadow .18s}.ds-flight:hover{border-color:#cdd4e6;box-shadow:0 1px 2px rgba(20,32,70,.05),0 10px 28px rgba(20,32,70,.07)}.ds-leg{display:flex;align-items:center;gap:14px}.ds-leg b{display:block;font-size:22px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-leg span{font-size:13.5px;color:#5b6577}.ds-path{width:96px;text-align:center;font-size:12.5px;color:#5b6577}.ds-path i{display:block;height:1px;margin:5px 0;background:#cdd4e6}.ds-car{margin-left:12px;font-size:14px;color:#5b6577}.ds-car b{font-size:14.5px;font-weight:600;color:#3f4a60;letter-spacing:0}.ds-count{text-align:right}.ds-count b{display:block;font-size:30px;font-weight:800;letter-spacing:-.03em;line-height:1.05;color:#12784a}.ds-count span,.ds-count em{display:block;font-size:14px;font-style:normal;color:#5b6577}.ds-buy{font-family:Onest,ui-sans-serif,system-ui,sans-serif;min-height:46px;padding:0 20px;border-radius:10px;border:0;background:#f5a524;color:#3a2600;font-weight:700;font-size:15.5px;cursor:pointer}.ds-buy:hover{background:#e8980f}.ds-buy:focus-visible{outline:3px solid #1e3163;outline-offset:2px}"
